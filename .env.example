# Exportar en la terminal para ejecución fuera del clúster; este archivo no se carga solo.
DECISION_PROVIDER=mock
PROVIDER_FAILURE=none
DECISION_THRESHOLD=0.90
DECISION_MIN_MARGIN=0.08
# Presupuesto conservador en bytes del JSON por llamada (no cuenta exacta de tokens).
DECISION_MAX_REQUEST_BYTES=24000
DECISION_SERVICE_CANDIDATES=2
DECISION_TIMEOUT_SECONDS=15
CLASSIFICATION_TIMEOUT_SECONDS=60
# DATABASE_URL=postgresql://usuario:clave@127.0.0.1:5432/jira_poc
# API_TOKEN=token-local-opcional

# Para el proveedor real, usar DECISION_PROVIDER=decision-1 y configurar:
# AZURE_ENDPOINT=https://RECURSO.cognitiveservices.azure.com
# DEPLOYMENT_NAME=NOMBRE_DEL_DESPLIEGUE
# AZURE_API_KEY=CLAVE
# Alternativa a AZURE_API_KEY: AZURE_ENTRA_TOKEN. No configurar ambas.
# El token Entra debe renovarse externamente antes de expirar.
# Cambiar esta revisión cuando se actualice el modelo bajo el mismo despliegue:
# DECISION_CONFIG_VERSION=1
